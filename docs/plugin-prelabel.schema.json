                { "type": "array", "minItems": 176, "maxItems": 176 },
                { "type": "array", "minItems": 178, "maxItems": 178 },
                { "type": "array", "minItems": 180, "maxItems": 180 },
                { "type": "array", "minItems": 182, "maxItems": 182 },
                { "type": "array", "minItems": 184, "maxItems": 184 },
                { "type": "array", "minItems": 186, "maxItems": 186 },
                { "type": "array", "minItems": 188, "maxItems": 188 },
                { "type": "array", "minItems": 190, "maxItems": 190 },
                { "type": "array", "minItems": 192, "maxItems": 192 },
                { "type": "array", "minItems": 194, "maxItems": 194 },
                { "type": "array", "minItems": 196, "maxItems": 196 },
                { "type": "array", "minItems": 198, "maxItems": 198 },
                { "type": "array", "minItems": 200, "maxItems": 200 }
                ]
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shapes"],
      "properties": {
        "cancelled": { "type": "boolean", "default": false },
        "completedImagePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![\\/])(?!.*(?:^|[\\/])\\.{1,2}(?:[\\/]|$))(?!.*:).+$"
          }
        },
        "shapes": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/shape" }
        }
      },
      "allOf": [
        {
          "if": { "required": ["cancelled"], "properties": { "cancelled": { "const": true } } },
          "then": {
            "required": ["completedImagePaths"],
            "properties": { "completedImagePaths": true }
          },
          "else": {
            "properties": { "completedImagePaths": { "type": "array", "maxItems": 0 } }
          }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/params" },
    { "$ref": "#/$defs/result" }
  ]
}
