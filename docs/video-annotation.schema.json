{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-label-tool.local/schemas/video-annotation-v1.json",
  "title": "my_label_tool host video annotation export v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "video", "labels", "images"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "my-label-tool.video" },
    "video": { "$ref": "#/$defs/video" },
    "labels": {
      "type": "array",
      "items": {
        "$ref": "https://my-label-tool.local/schemas/plugin-exporter-v1.json#/$defs/label"
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "https://my-label-tool.local/schemas/plugin-exporter-v1.json#/$defs/exportData/properties/images/items"
      }
    }
  },
  "$defs": {
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sourcePath",
        "frameInterval",
        "totalFrames",
        "width",
        "height",
        "frames"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "frameInterval": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "totalFrames": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "frameIndex", "timestampSeconds"],
            "properties": {
              "name": { "type": "string", "pattern": "^frame-[0-9]{6}\\.png$" },
              "frameIndex": { "type": "integer", "minimum": 0 },
              "timestampSeconds": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
