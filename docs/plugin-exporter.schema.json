{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-label-tool.local/schemas/plugin-exporter-v1.json",
  "title": "my_label_tool exporter.export v1",
  "$defs": {
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "labelId", "points"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["rect", "polygon", "point"] },
        "labelId": { "type": "string", "minLength": 1 },
        "points": { "type": "array", "items": { "type": "number" } },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" }
            ]
          }
        },
        "frameIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "color", "shapeType"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "shortcut": { "type": "string", "pattern": "^[a-z0-9]$" },
        "shapeType": { "enum": ["any", "rect", "polygon", "point"] }
      }
    },
    "exportData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "images"],
      "properties": {
        "labels": { "type": "array", "items": { "$ref": "#/$defs/label" } },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "name", "width", "height", "annotations"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 },
              "annotations": { "type": "array", "items": { "$ref": "#/$defs/annotation" } }
            }
          }
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formatId", "exportData", "options", "outputBaseName"],
      "properties": {
        "formatId": { "type": "string", "minLength": 1 },
        "exportData": { "$ref": "#/$defs/exportData" },
        "options": { "type": "object" },
        "outputBaseName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?!\\.{1,2}$)(?!.*[\\\\/<>:\"|?*\\u0000-\\u001F])(?!.*[ .]$)\\S(?:.*\\S)?$"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath"],
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768,
          "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$))(?!.*[:<>\"|?*\\u0000-\\u001F])(?!.*[ .](?:[\\\\/]|$)).+$"
        },
        "contentUtf8": { "type": "string" },
        "contentBase64": { "type": "string", "contentEncoding": "base64" }
      },
      "oneOf": [
        {
          "required": ["contentUtf8"],
          "properties": { "contentUtf8": { "type": "string" }, "contentBase64": false }
        },
        {
          "required": ["contentBase64"],
          "properties": { "contentBase64": { "type": "string" }, "contentUtf8": false }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/file" }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/params" },
    { "$ref": "#/$defs/result" }
  ]
}
