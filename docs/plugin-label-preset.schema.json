{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-label-tool.local/schemas/plugin-label-preset-v1.json",
  "title": "my_label_tool label-preset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "labels"],
  "properties": {
    "id": { "$ref": "#/$defs/namespacedId" },
    "name": { "type": "string", "minLength": 1 },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/label" }
    }
  },
  "$defs": {
    "namespacedId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9]+){1,}$"
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "color", "shapeType"],
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "name": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "shortcut": { "type": "string", "pattern": "^[a-z0-9]$" },
        "shapeType": { "enum": ["any", "rect", "polygon", "point"] }
      }
    }
  }
}
