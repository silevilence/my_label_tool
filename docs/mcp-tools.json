      "openWorldHint": false
    }
  },
  {
    "name": "control_request",
    "description": "申请人工批准操作控制权，随后查询控制状态",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "permissions": {
          "type": "array",
          "items": {
            "enum": [
              "annotations",
              "save",
              "export",
              "prelabel"
            ]
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        }
      },
      "required": [
        "projectId",
        "permissions"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "control_status",
    "description": "查询申请、租约、锁定状态；仅向租约所有者返回 leaseId",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "control_renew",
    "description": "续期当前会话的五分钟租约",
    "inputSchema": {
      "type": "object",
      "properties": {
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "leaseId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "control_release",
    "description": "释放当前会话控制权",
    "inputSchema": {
      "type": "object",
      "properties": {
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "leaseId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "annotations_apply",
    "description": "原子批量新增、完整更新或删除标注，一次事务可整体撤销",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "imageId",
              "operation"
            ],
            "properties": {
              "imageId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "operation": {
                "enum": [
                  "add",
                  "update",
                  "delete"
                ]
              },
              "annotation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "type",
                  "labelId",
                  "points"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "type": {
                    "enum": [
                      "rect",
                      "polygon",
                      "point"
                    ]
                  },
                  "labelId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "points": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 20000
                  },
                  "attributes": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  },
                  "frameIndex": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "annotationId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      },
      "required": [
        "projectId",
        "expectedRevision",
        "leaseId",
        "changes"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "project_save",
    "description": "保存至当前项目已确认的位置，返回任务标识",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "projectId",
        "expectedRevision",
        "leaseId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "project_export",
    "description": "导出到人工授权目录，覆盖既有文件需要人工确认",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "format": {
          "enum": [
            "json",
            "coco",
            "voc",
            "yolo",
            "custom"
          ]
        }
      },
      "required": [
        "projectId",
        "expectedRevision",
        "leaseId",
        "format"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "prelabel_start",
    "description": "使用已配置的本地模型预打标指定图片，返回任务标识",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "imageIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        }
      },
      "required": [
        "projectId",
        "expectedRevision",
        "leaseId",
        "modelId",
        "imageIds"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "task_status",
    "description": "查询当前会话创建的任务及进度",
    "inputSchema": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "taskId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "task_cancel",
    "description": "取消当前会话创建的任务",
    "inputSchema": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "taskId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    }
  }
]
