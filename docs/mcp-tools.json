  },
  {
    "name": "project_read",
    "description": "读取当前项目、图片、标签和已配置模型的稳定标识",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "annotations_read",
    "description": "读取指定项目图片的原图像素标注",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "imageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "projectId",
        "imageId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
